# Copier vers `.env.local` à la racine du dépôt et/ou `app/.env.local`.
# Les scripts CLI chargent d’abord la racine puis `app/` (sans écraser les clés déjà définies).

# Base MongoDB (obligatoire pour l’app et les scripts)
MONGODB_URI=mongodb://127.0.0.1:27017/gestionedt

# NextAuth / Auth.js — obligatoire en production pour signer les JWT
# Générer : openssl rand -base64 32
AUTH_SECRET=dzVWj8qcObrhF+zUpx6N6oPSXym7S3YA1J1Gy4lMm7k=

# URL publique de l’app (ex. http://localhost:3000 en local)
AUTH_URL=http://localhost:3000
# Alias historiques encore lus par certains outils
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Compte admin créé par `npm run init:admin` (dans le dossier `app/`)
# INIT_ADMIN_EMAIL=admin@localhost
# INIT_ADMIN_PASSWORD=admin
